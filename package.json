{
  "name": "review-range-tracker",
  "displayName": "Review Range Tracker",
  "description": "Track reviewed line ranges in VS Code workspaces.",
  "version": "0.0.1-pre",
  "publisher": "taiga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssaattww/RevMem.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:reviewRange.markSelectionReviewed",
    "onCommand:reviewRange.unmarkSelectionReviewed",
    "onCommand:reviewRange.markFileReviewed",
    "onCommand:reviewRange.unmarkFileReviewed",
    "onView:reviewRange.currentContext",
    "onCommand:reviewRange.refreshContext",
    "onCommand:reviewRange.selectContext",
    "onView:reviewRange.globalUnderstanding",
    "onCommand:reviewRange.refreshGlobalUnderstanding",
    "onCommand:reviewRange.toggleGlobalLayer",
    "onCommand:reviewRange.startGlobalUnderstandingFolder",
    "onCommand:reviewRange.stopGlobalUnderstandingFolder",
    "onCommand:reviewRange.resumeGlobalUnderstandingFolder",
    "onView:reviewRange.reviewContexts",
    "onCommand:reviewRange.refreshReviewContexts",
    "onCommand:reviewRange.redetectPullRequest",
    "onCommand:reviewRange.reconnectGitHub",
    "onCommand:reviewRange.refreshReviewContextCache",
    "onCommand:reviewRange.toggleReviewContextLayer",
    "onCommand:reviewRange.hideReviewContext",
    "onCommand:reviewRange.openReviewContextDiff"
  ],
  "main": "./dist/t305-extension.js",
  "extensionKind": ["workspace"],
  "contributes": {
    "commands": [
      { "command": "reviewRange.markSelectionReviewed", "title": "選択範囲を確認済みにする", "category": "Review Range", "enablement": "editorTextFocus" },
      { "command": "reviewRange.unmarkSelectionReviewed", "title": "選択範囲の確認済みを解除する", "category": "Review Range", "enablement": "editorTextFocus" },
      { "command": "reviewRange.markFileReviewed", "title": "ファイル全体を確認済みにする", "category": "Review Range", "enablement": "editorTextFocus" },
      { "command": "reviewRange.unmarkFileReviewed", "title": "ファイル全体の確認済みを解除する", "category": "Review Range", "enablement": "editorTextFocus" },
      { "command": "reviewRange.refreshContext", "title": "現在のコンテキストを再計算", "category": "Review Range" },
      { "command": "reviewRange.selectContext", "title": "現在のコンテキストを選択", "category": "Review Range" },
      { "command": "reviewRange.openPrProgressItem", "title": "PR Progress項目を開く", "category": "Review Range" },
      { "command": "reviewRange.refreshGlobalUnderstanding", "title": "Global理解率を再計算", "category": "Review Range" },
      { "command": "reviewRange.toggleGlobalLayer", "title": "Global確認済みレイヤーを切り替え", "category": "Review Range" },
      { "command": "reviewRange.startGlobalUnderstandingFolder", "title": "Global Understanding folderを開始", "category": "Review Range" },
      { "command": "reviewRange.stopGlobalUnderstandingFolder", "title": "Global Understanding folderを停止", "category": "Review Range" },
      { "command": "reviewRange.resumeGlobalUnderstandingFolder", "title": "Global Understanding folderを再開", "category": "Review Range" },
      { "command": "reviewRange.refreshReviewContexts", "title": "Review Contextsを更新", "category": "Review Range" },
      { "command": "reviewRange.redetectPullRequest", "title": "PRを再検出", "category": "Review Range" },
      { "command": "reviewRange.reconnectGitHub", "title": "GitHubへ再接続", "category": "Review Range" },
      { "command": "reviewRange.refreshReviewContextCache", "title": "PR cacheを更新", "category": "Review Range" },
      { "command": "reviewRange.toggleReviewContextLayer", "title": "PR layerを切り替え", "category": "Review Range" },
      { "command": "reviewRange.hideReviewContext", "title": "Review Contextsから表示を削除", "category": "Review Range" },
      { "command": "reviewRange.openReviewContextDiff", "title": "PR diffを開く", "category": "Review Range" }
    ],
    "menus": {
      "editor/context": [
        { "command": "reviewRange.markSelectionReviewed", "when": "editorTextFocus && (!isInDiffEditor || (isInDiffEditor && reviewRange.prProgressDiffReviewActions))", "group": "reviewRange@1" },
        { "command": "reviewRange.unmarkSelectionReviewed", "when": "editorTextFocus && (!isInDiffEditor || (isInDiffEditor && reviewRange.prProgressDiffReviewActions))", "group": "reviewRange@2" },
        { "command": "reviewRange.markFileReviewed", "when": "editorTextFocus && (!isInDiffEditor || (isInDiffEditor && reviewRange.prProgressDiffReviewActions))", "group": "reviewRange@3" },
        { "command": "reviewRange.unmarkFileReviewed", "when": "editorTextFocus && (!isInDiffEditor || (isInDiffEditor && reviewRange.prProgressDiffReviewActions))", "group": "reviewRange@4" },
        { "command": "reviewRange.startGlobalUnderstandingFolder", "when": "resourceScheme == file || resourceScheme == vscode-remote", "group": "reviewRange@5" },
        { "command": "reviewRange.stopGlobalUnderstandingFolder", "when": "resourceScheme == file || resourceScheme == vscode-remote", "group": "reviewRange@6" },
        { "command": "reviewRange.resumeGlobalUnderstandingFolder", "when": "resourceScheme == file || resourceScheme == vscode-remote", "group": "reviewRange@7" }
      ],
      "view/title": [
        { "command": "reviewRange.refreshContext", "when": "view == reviewRange.currentContext", "group": "navigation@1" },
        { "command": "reviewRange.selectContext", "when": "view == reviewRange.currentContext", "group": "navigation@2" },
        { "command": "reviewRange.refreshGlobalUnderstanding", "when": "view == reviewRange.globalUnderstanding", "group": "navigation@1" },
        { "command": "reviewRange.toggleGlobalLayer", "when": "view == reviewRange.globalUnderstanding", "group": "navigation@2" },
        { "command": "reviewRange.refreshReviewContexts", "when": "view == reviewRange.reviewContexts", "group": "navigation@1" },
        { "command": "reviewRange.redetectPullRequest", "when": "view == reviewRange.reviewContexts", "group": "navigation@2" },
        { "command": "reviewRange.reconnectGitHub", "when": "view == reviewRange.reviewContexts", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "reviewRange.startGlobalUnderstandingFolder", "when": "view == reviewRange.globalUnderstanding && viewItem == reviewRange.globalUnderstandingFolder.start", "group": "inline" },
        { "command": "reviewRange.stopGlobalUnderstandingFolder", "when": "view == reviewRange.globalUnderstanding && viewItem == reviewRange.globalUnderstandingFolder.stop", "group": "inline" },
        { "command": "reviewRange.resumeGlobalUnderstandingFolder", "when": "view == reviewRange.globalUnderstanding && viewItem == reviewRange.globalUnderstandingFolder.resume", "group": "inline" },
        { "command": "reviewRange.openPrProgressItem", "when": "view == reviewRange.prProgress && viewItem == reviewRange.prProgressFile", "group": "inline" },
        { "command": "reviewRange.openReviewContextDiff", "when": "view == reviewRange.reviewContexts && viewItem == reviewRange.reviewContextPullRequest", "group": "inline@1" },
        { "command": "reviewRange.refreshReviewContextCache", "when": "view == reviewRange.reviewContexts && viewItem == reviewRange.reviewContextPullRequest", "group": "inline@2" },
        { "command": "reviewRange.toggleReviewContextLayer", "when": "view == reviewRange.reviewContexts && viewItem == reviewRange.reviewContextPullRequest", "group": "inline@3" },
        { "command": "reviewRange.hideReviewContext", "when": "view == reviewRange.reviewContexts", "group": "navigation@4" }
      ]
    },
    "configuration": {
      "title": "Review Range",
      "properties": {
        "reviewRange.showGlobalReviewed": { "type": "boolean", "default": true, "description": "Global確認済み範囲を通常エディタの装飾へ重ねて表示します。" },
        "reviewRange.ignoreWhitespaceChanges": { "type": "boolean", "default": false, "description": "空白のみの編集を確認済み範囲の追従で無視します。" },
        "reviewRange.ignoreEolChanges": { "type": "boolean", "default": false, "description": "改行コードのみの編集を確認済み範囲の追従で無視します。" },
        "reviewRange.showGutterIcon": { "type": "boolean", "default": true, "description": "確認済み行のガターアイコンを表示します。" },
        "reviewRange.showOverviewRuler": { "type": "boolean", "default": false, "description": "確認済み範囲をOverview Rulerへ表示します。" },
        "reviewRange.globalUnderstanding.autoStartDescendants": { "type": "boolean", "default": false, "description": "開いたファイルの所属folderより深いGlobal Understanding scopeを自動開始します。停止済みscopeは再開しません。" },
        "reviewRange.diagnostics.detailed": { "type": "boolean", "default": false, "description": "詳細診断を有効にし、再計算理由・処理内訳・対象ファイル名/pathをReview Range Outputと進捗tooltipへ表示します。ファイル名やpathには機密情報が含まれる可能性があります。" },
        "reviewRange.exclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/.git/**", "**/node_modules/**", "**/bin/**", "**/obj/**", "**/dist/**", "**/build/**"],
          "description": "PR進捗とGlobal理解率の集計対象から除外するファイルglobです。有効な配列は既定値を上書きし、空配列ではbinaryと.git以外を再包含できます。単一backslashはseparator、literal backslashは二重backslashで指定します（settings.jsonでは \"a\\\\\\\\b.ts\"）。"
        },
        "reviewRange.maxSnapshotFileSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 5242880,
          "description": "Git管理外ファイルの1 snapshotで許可する圧縮後の最大byte数です。変更はExtension Hostの再読み込み後に新規snapshotへ適用されます。"
        }
      }
    },
    "colors": [
      { "id": "reviewRange.reviewedBackground", "description": "確認済み行の背景色。", "defaults": { "dark": "#a0a0a01f", "light": "#6060601f", "highContrast": "#a0a0a033", "highContrastLight": "#60606033" } },
      { "id": "reviewRange.reviewedOverviewRuler", "description": "確認済み範囲のOverview Ruler色。", "defaults": { "dark": "#a0a0a08c", "light": "#6060608c", "highContrast": "#a0a0a0cc", "highContrastLight": "#606060cc" } }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "reviewRange", "title": "Review Range", "icon": "media/review-range.svg" }]
    },
    "views": {
      "reviewRange": [
        { "id": "reviewRange.currentContext", "name": "Current Context" },
        { "id": "reviewRange.prProgress", "name": "PR Progress" },
        { "id": "reviewRange.globalUnderstanding", "name": "Global Understanding" },
        { "id": "reviewRange.reviewContexts", "name": "Review Contexts" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "npm run compile",
    "lint": "eslint src test --max-warnings=0",
    "package": "npm run compile && vsce package --no-dependencies",
    "typecheck:contracts": "tsc -p type-fixtures/contracts/tsconfig.json",
    "validate:architecture": "node tools/validate-architecture.mjs",
    "validate:architecture:negative": "node tools/validate-architecture.mjs --source-root type-fixtures/architecture-invalid --layer-root src --expect-violations 11",
    "compile:test": "tsc -p tsconfig.test.json",
